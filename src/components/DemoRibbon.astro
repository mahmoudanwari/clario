---
import { href, type Locale } from '../i18n/config.ts';
import { t } from '../i18n/ui.ts';

interface Props { lang: Locale }
const { lang } = Astro.props;
const strings = t(lang);
---

<div class="demo-ribbon" role="note">
  <p class="container-x demo-ribbon__inner">
    <span>{strings.demo.ribbon}</span>
    <a href={href(lang, 'demo')} class="link-underline demo-ribbon__link">{strings.demo.ribbonLink}</a>
  </p>
</div>

<style>
  .demo-ribbon {
    background: var(--color-forest-night);
    color: var(--color-ivory);
    font-size: 0.78rem;
    line-height: 1.4;
  }
  .demo-ribbon__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.4rem 0.9rem;
    padding-block: 0.55rem;
    text-align: center;
  }
  .demo-ribbon__link {
    font-weight: 700;
    white-space: nowrap;
    color: var(--color-sand);
  }
</style>
