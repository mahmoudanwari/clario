---
interface Props {
  eyebrow?: string;
  tag?: 'h1' | 'h2' | 'h3';
  align?: 'left' | 'center';
  class?: string;
}
const { eyebrow, tag: Tag = 'h2', align = 'left', class: className = '' } = Astro.props;
---

<div class={`section-heading section-heading--${align} ${className}`} data-reveal="fade">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag class="section-heading__title font-display"><slot /></Tag>
  <slot name="lede" />
</div>

<style>
  .section-heading { display: flex; flex-direction: column; gap: 1rem; }
  .section-heading--center { align-items: center; text-align: center; }
  .section-heading__title {
    font-size: var(--step-3);
    color: var(--color-ink);
    max-width: 38rem;
  }
  .section-heading--center .section-heading__title { max-width: 42rem; }
  .section-heading__title :global(em) { color: var(--color-clay); font-style: italic; }
  .on-dark .section-heading__title { color: var(--color-ivory); }
  .on-dark .section-heading__title :global(em) { color: var(--color-sand); }
</style>
