---
import { locales, localeMeta, swapLocale, type Locale } from '../i18n/config.ts';
import { t } from '../i18n/ui.ts';

interface Props { lang: Locale; class?: string }
const { lang, class: className = '' } = Astro.props;
const strings = t(lang);
const currentPath = Astro.url.pathname;
---

<div class={`lang-switch ${className}`}>
  <span class="sr-only-focusable">{strings.a11y.language}</span>
  <div class="lang-switch__group" role="group" aria-label={strings.a11y.language}>
    {locales.map((l) => (
      <a
        href={swapLocale(currentPath, l)}
        class="lang-switch__item"
        aria-current={l === lang ? 'true' : undefined}
        lang={localeMeta[l].htmlLang}
        hreflang={localeMeta[l].htmlLang}
      >
        {localeMeta[l].short}
      </a>
    ))}
  </div>
</div>

<style>
  .lang-switch__group {
    display: inline-flex;
    gap: 0.2rem;
    padding: 0.2rem;
    border-radius: 999px;
    background: rgb(34 42 39 / 0.06);
  }
  .on-dark .lang-switch__group { background: rgb(246 242 233 / 0.1); }
  .lang-switch__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    padding: 0.35rem 0.55rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: inherit;
    text-decoration: none;
    transition: background-color var(--dur-fast);
  }
  .lang-switch__item:hover { background: rgb(34 42 39 / 0.1); }
  .on-dark .lang-switch__item:hover { background: rgb(246 242 233 / 0.14); }
  .lang-switch__item[aria-current='true'] {
    background: var(--color-forest);
    color: var(--color-ivory);
  }
  .on-dark .lang-switch__item[aria-current='true'] {
    background: var(--color-sand);
    color: var(--color-forest-night);
  }
</style>
