---
/**
 * Image slot with automatic placeholder → real-asset swap.
 *
 * Drop a file named exactly like `file` (any of .jpg/.jpeg/.png/.webp/.avif)
 * into `src/assets/clario/` and this component will pick it up automatically
 * via Astro's built-in image optimisation — no code changes required.
 * Until then, it renders a labelled, aspect-correct placeholder so layout
 * never shifts when the real photo arrives.
 */
import { Image } from 'astro:assets';
import { getImage, showPlaceholderLabels, type ImageFile } from '../data/images.ts';
import type { Locale } from '../i18n/config.ts';

interface Props {
  file: ImageFile;
  lang: Locale;
  class?: string;
  sizes?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  /**
   * How the image sits in its container.
   * `cover` (default) fills the box and crops; `width` keeps the natural
   * ratio at full width, for containers with no height of their own.
   *
   * This is a prop rather than a CSS class on the caller's side because
   * Astro's scoped styles do not reach an <img> rendered two component
   * layers down — a parent's `.foo__img { object-fit: cover }` silently
   * never matches. The classes below are defined globally instead.
   */
  fit?: 'cover' | 'width';
}

const {
  file,
  lang,
  class: className = '',
  sizes,
  loading = 'lazy',
  fetchpriority = 'auto',
  fit = 'cover',
} = Astro.props;
const fitClass = fit === 'cover' ? 'media-fit-cover' : 'media-fit-width';
const asset = getImage(file);

const aspectRatio = asset.aspect
  .split(':')
  .map(Number)
  .reduce((a, b) => a / b);

// Look for a real asset the user has dropped in. Glob is evaluated at build
// time, so this check costs nothing at runtime.
const real = import.meta.glob<{ default: ImageMetadata }>('/src/assets/clario/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const match = Object.entries(real).find(([path]) => {
  const name = path.split('/').pop()?.replace(/\.[^.]+$/, '');
  return name === asset.file;
});
const resolvedImage = match?.[1]?.default;

// Responsive widths: capped at the source width so nothing is upscaled.
// Without this, Astro emits a single full-size file and phones download it.
const widthLadder = [480, 768, 1024, 1366, 1680, 2048, 2560];
const widths = resolvedImage
  ? [...new Set(widthLadder.filter((w) => w <= resolvedImage.width).concat(resolvedImage.width))]
  : undefined;

const toneBg: Record<string, string> = {
  forest: 'linear-gradient(145deg, #1f4a3c, #14332a)',
  sage: 'linear-gradient(145deg, #93b6a2, #6d9482)',
  sand: 'linear-gradient(145deg, #d6a574, #b9824f)',
  ivory: 'linear-gradient(145deg, #eaf0ea, #d7e0d8)',
};
---

{
  resolvedImage ? (
    <Image
      src={resolvedImage}
      alt={asset.alt[lang]}
      class={`${fitClass} ${className}`}
      widths={widths}
      sizes={sizes ?? '100vw'}
      loading={loading}
      fetchpriority={fetchpriority}
      style={asset.focus ? `object-position:${asset.focus}` : undefined}
    />
  ) : (
    <div
      class={`media-placeholder ${fit === 'cover' ? 'media-placeholder--cover' : ''} ${className}`}
      style={`--mp-ratio:${aspectRatio};--mp-bg:${toneBg[asset.tone] ?? toneBg.forest}`}
      role="img"
      aria-label={asset.alt[lang]}
      data-asset-id={asset.id}
    >
      <svg class="media-placeholder__icon" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
        <rect x="4" y="4" width="40" height="40" rx="6" fill="none" stroke="currentColor" stroke-width="2" opacity="0.5" />
        <circle cx="17" cy="17" r="4" fill="none" stroke="currentColor" stroke-width="2" opacity="0.7" />
        <path d="M6 33 L18 23 L26 30 L34 20 L44 30" fill="none" stroke="currentColor" stroke-width="2" opacity="0.7" />
      </svg>
      {showPlaceholderLabels && (
        <span class="media-placeholder__label">
          <strong>{asset.id}</strong>
          <span>{asset.file}</span>
        </span>
      )}
    </div>
  )
}

<style>
  .media-placeholder {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    aspect-ratio: var(--mp-ratio);
    width: 100%;
    background: var(--mp-bg);
    color: rgb(246 242 233 / 0.85);
    border-radius: inherit;
    overflow: hidden;
  }
  .media-placeholder::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(45deg, rgb(255 255 255 / 0.05) 0 2px, transparent 2px 14px);
  }
  .media-placeholder__icon {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 22%;
    min-width: 2rem;
    max-width: 4rem;
    transform: translate(-50%, -50%);
  }
  .media-placeholder__label {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin: 0.75rem;
    padding: 0.4rem 0.6rem;
    border-radius: 0.5rem;
    background: rgb(14 36 30 / 0.55);
    backdrop-filter: blur(3px);
    font-size: 0.68rem;
    line-height: 1.3;
    max-width: calc(100% - 1.5rem);
  }
  .media-placeholder__label strong { font-weight: 800; letter-spacing: 0.04em; }
  .media-placeholder__label span { opacity: 0.8; word-break: break-word; }
</style>
