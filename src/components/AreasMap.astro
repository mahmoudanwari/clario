---
import type { Locale } from '../i18n/config.ts';
import { site } from '../data/site.ts';

interface Props { lang: Locale }
const { lang } = Astro.props;
---

<div class="areas" data-reveal="fade">
  <div class="areas__panel" aria-hidden="true">
    <svg viewBox="0 0 100 100" class="areas__lines" preserveAspectRatio="none">
      <line x1="52" y1="54" x2="53" y2="22" /><line x1="52" y1="54" x2="33" y2="33" />
      <line x1="52" y1="54" x2="64" y2="50" /><line x1="52" y1="54" x2="56" y2="36" />
      <line x1="52" y1="54" x2="84" y2="64" /><line x1="52" y1="54" x2="61" y2="75" />
      <line x1="52" y1="54" x2="46" y2="76" /><line x1="33" y1="33" x2="16" y2="25" />
    </svg>
    {site.cities.map((city) => (
      <span class="areas__dot" style={`left:${city.x}%;top:${city.y}%`} data-city={city.id}>
        <span class="areas__dot-core"></span>
        <span class="areas__dot-label">{city[lang]}</span>
      </span>
    ))}
  </div>

  <ul class="areas__list">
    {site.cities.map((city) => (
      <li>{city[lang]}</li>
    ))}
  </ul>
</div>

<style>
  .areas { display: grid; gap: 2rem; }
  @media (min-width: 56rem) { .areas { grid-template-columns: 1.3fr 1fr; align-items: center; } }

  .areas__panel {
    position: relative;
    aspect-ratio: 1/1;
    max-width: 30rem;
    margin-inline: auto;
    border-radius: var(--radius-xl);
    background: linear-gradient(160deg, var(--color-mist), var(--color-sage-soft));
  }
  .areas__lines { position: absolute; inset: 0; width: 100%; height: 100%; }
  .areas__lines line { stroke: var(--color-forest); stroke-width: 0.3; opacity: 0.35; }

  .areas__dot {
    position: absolute;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .areas__dot-core {
    width: 0.65rem; height: 0.65rem;
    border-radius: 999px;
    background: var(--color-clay);
    box-shadow: 0 0 0 4px rgb(138 85 39 / 0.18);
  }
  .areas__dot-label {
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--color-forest);
    background: rgb(251 249 244 / 0.85);
    padding: 0.1rem 0.4rem;
    border-radius: 0.3rem;
    white-space: nowrap;
  }

  .areas__list {
    list-style: none;
    margin: 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.9rem;
    font-weight: 650;
  }
  @media (min-width: 30rem) { .areas__list { grid-template-columns: repeat(3, auto); justify-content: start; } }
  .areas__list li {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-line);
  }
</style>
