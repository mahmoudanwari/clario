---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import ServiceCard from '../../../components/ServiceCard.astro';
import { localeStaticPaths, href } from '../../../i18n/config.ts';
import { t } from '../../../i18n/ui.ts';
import { pages } from '../../../content/pages.ts';
import { services } from '../../../data/services.ts';

export function getStaticPaths() {
  return localeStaticPaths();
}

const { lang } = Astro.params;
const strings = t(lang);
const copy = pages[lang].services;
---

<BaseLayout lang={lang} title={copy.meta.title} description={copy.meta.description}>
  <PageHero
    lang={lang}
    eyebrow={copy.eyebrow}
    title={copy.title}
    lede={copy.lede}
    image="services-overview-hero"
  />

  <section class="section section--top-tight">
    <div class="container-x">
      <div class="services-grid" data-reveal-group>
        {services.map((service) => <ServiceCard lang={lang} service={service} />)}
      </div>
      <p class="pricing-note">{strings.pricing.note}</p>
    </div>
  </section>

  <section class="section surface-forest on-dark">
    <div class="container-x combine">
      <SectionHeading eyebrow={copy.combineTitle}>
        {copy.combineTitle}
        <p class="lede" slot="lede">{copy.combineText}</p>
      </SectionHeading>
      <div class="combine__actions">
        <a href={href(lang, 'quote')} class="btn btn-sand">
          {strings.cta.quote}
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
        <a href={href(lang, 'book')} class="btn btn-ghost on-dark">{strings.cta.book}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <SectionHeading eyebrow={copy.sectorsTitle}>{copy.sectorsTitle}</SectionHeading>
      <ul class="sectors" data-reveal-group>
        {copy.sectors.map((sector) => (
          <li class="sector" data-reveal="fade">
            <h3>{sector.title}</h3>
            <p>{sector.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .section--top-tight { padding-top: 0; }
  .services-grid { display: grid; gap: 1.75rem; grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .services-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 72rem) { .services-grid { grid-template-columns: repeat(4, 1fr); } }
  .pricing-note { max-width: 42rem; font-size: 0.85rem; color: var(--color-ink-soft); margin-top: 2rem; }

  .combine { display: flex; flex-direction: column; gap: 2rem; align-items: flex-start; }
  .combine__actions { display: flex; flex-wrap: wrap; gap: 1rem; }

  .sectors { list-style: none; margin: 2.5rem 0 0; padding: 0; display: grid; gap: 2rem; grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .sectors { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .sectors { grid-template-columns: repeat(4, 1fr); } }
  .sector { border-top: 1px solid var(--color-line); padding-top: 1.1rem; }
  .sector h3 { font-size: 1.05rem; margin-bottom: 0.4rem; }
  .sector p { color: var(--color-ink-soft); font-size: 0.92rem; margin: 0; line-height: 1.55; }
</style>
