---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookingCalendar from '../../components/BookingCalendar.astro';
import Media from '../../components/Media.astro';
import { localeStaticPaths, href } from '../../i18n/config.ts';
import { t } from '../../i18n/ui.ts';
import { interactive } from '../../content/interactive.ts';

export function getStaticPaths() {
  return localeStaticPaths();
}

const { lang } = Astro.params;
const strings = t(lang);
const copy = interactive[lang].bookPage;
---

<BaseLayout lang={lang} title={copy.meta.title} description={copy.meta.description}>
  <section class="book-page section">
    <div class="container-x book-page__grid">
      <div class="book-page__main">
        <header class="book-page__head">
          <p class="eyebrow">{copy.eyebrow}</p>
          <h1 class="book-page__title font-display" set:html={copy.title} />
          <p class="lede">{copy.lede}</p>
        </header>
        <BookingCalendar lang={lang} />
      </div>

      <aside class="book-page__aside">
        <div class="book-page__media" data-reveal="mask">
          <Media file="book-side-assessment" lang={lang} class="book-page__img" sizes="(min-width: 64rem) 26vw, 85vw" />
        </div>
        <div class="book-page__help">
          <a href={href(lang, 'quote')} class="btn btn-ghost">{strings.cta.quote}</a>
          <a href={href(lang, 'contact')} class="btn btn-ghost">{strings.cta.contact}</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .book-page__grid { display: grid; gap: 3rem; align-items: start; }
  @media (min-width: 72rem) { .book-page__grid { grid-template-columns: 1.6fr 0.6fr; gap: 4rem; } }
  .book-page__head { margin-bottom: 2.5rem; display: flex; flex-direction: column; gap: 1rem; }
  .book-page__title { font-size: var(--step-4); }
  .book-page__title :global(em) { font-style: italic; color: var(--color-clay); }
  .book-page__aside { display: flex; flex-direction: column; gap: 1.5rem; position: sticky; top: 7rem; }
  .book-page__media { border-radius: var(--radius-lg); overflow: hidden; }
  .book-page__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .book-page__help { display: flex; flex-direction: column; gap: 0.75rem; align-items: flex-start; }
</style>
