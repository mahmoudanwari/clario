---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Media from '../../components/Media.astro';
import { localeStaticPaths, href } from '../../i18n/config.ts';
import { t } from '../../i18n/ui.ts';
import { pages } from '../../content/pages.ts';
import type { ImageFile } from '../../data/images.ts';

export function getStaticPaths() {
  return localeStaticPaths();
}

const { lang } = Astro.params;
const strings = t(lang);
const copy = pages[lang].sustainability;

const journeyImages: ImageFile[] = [
  'sustainability-journey-products',
  'sustainability-journey-cloths',
  'sustainability-journey-water',
  'sustainability-journey-planning',
];
---

<BaseLayout lang={lang} title={copy.meta.title} description={copy.meta.description}>
  <PageHero lang={lang} eyebrow={copy.eyebrow} title={copy.title} lede={copy.lede} image="sustainability-hero-materials" />

  <!-- Scroll-driven journey -->
  <section class="section section--top-tight journey-section">
    <div class="container-x">
      <SectionHeading eyebrow={copy.journeyEyebrow}>
        <Fragment set:html={copy.journeyTitle} />
      </SectionHeading>

      <div class="journey" data-journey>
        <div class="journey__rail" aria-hidden="true">
          <span class="journey__progress" data-journey-progress></span>
        </div>
        <ol class="journey__list">
          {copy.journey.map((step, i) => (
            <li class="journey__step" data-journey-step data-reveal="fade">
              <div class="journey__text">
                <span class="journey__kicker">{step.kicker}</span>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
              <div class="journey__media" data-reveal="mask">
                <Media file={journeyImages[i]!} lang={lang} class="journey__img" sizes="(min-width: 64rem) 32vw, 85vw" />
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Principles -->
  <section class="section surface-forest on-dark">
    <div class="container-x">
      <SectionHeading eyebrow={copy.principlesEyebrow}>{copy.principlesTitle}</SectionHeading>
      <ul class="principles" data-reveal-group>
        {copy.principles.map((p) => (
          <li data-reveal="fade">
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))}
      </ul>
      <p class="principles__note">{copy.note}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container-x sustain-cta">
      <a href={href(lang, 'quote')} class="btn">
        {strings.cta.quote}
        <span class="btn-arrow" aria-hidden="true">→</span>
      </a>
      <a href={href(lang, 'services')} class="btn btn-ghost">{strings.cta.explore}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .section--top-tight { padding-top: 0; }
  .journey { position: relative; margin-top: 3rem; }
  .journey__rail {
    position: absolute;
    left: 0.45rem;
    top: 0; bottom: 0;
    width: 2px;
    background: var(--color-line);
  }
  @media (min-width: 64rem) { .journey__rail { left: 50%; transform: translateX(-50%); } }
  .journey__progress {
    display: block;
    width: 100%;
    height: var(--journey-progress, 0%);
    background: var(--color-forest);
    transition: height 120ms linear;
  }

  .journey__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: clamp(3rem, 6vw, 6rem); }
  .journey__step {
    position: relative;
    padding-left: 2.25rem;
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 64rem) {
    .journey__step { grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; padding-left: 0; }
    .journey__step:nth-child(even) .journey__text { order: 2; }
  }
  .journey__step::before {
    content: '';
    position: absolute;
    left: 0; top: 0.4rem;
    width: 1rem; height: 1rem;
    border-radius: 999px;
    background: var(--color-sand);
    box-shadow: 0 0 0 4px var(--color-ivory);
  }
  @media (min-width: 64rem) { .journey__step::before { left: 50%; transform: translateX(-50%); top: 50%; margin-top: -0.5rem; } }

  .journey__kicker { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-clay); }
  .journey__text h3 { font-size: var(--step-2); margin: 0.5rem 0 0.75rem; }
  .journey__text p { color: var(--color-ink-soft); line-height: 1.7; max-width: 32rem; }
  .journey__media { border-radius: var(--radius-lg); overflow: hidden; }
  .journey__img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .principles { list-style: none; margin: 2.5rem 0 0; padding: 0; display: grid; gap: 2rem; grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .principles { grid-template-columns: repeat(2, 1fr); } }
  .principles li { border-top: 1px solid var(--color-line-light); padding-top: 1.1rem; }
  .principles h3 { font-size: 1.05rem; color: var(--color-sand); margin-bottom: 0.4rem; }
  .principles p { color: rgb(246 242 233 / 0.78); font-size: 0.93rem; line-height: 1.6; margin: 0; }
  .principles__note { margin-top: 2.5rem; font-size: 0.85rem; color: rgb(246 242 233 / 0.62); max-width: 42rem; }

  .sustain-cta { display: flex; flex-wrap: wrap; gap: 1rem; }
</style>

<script>
  /* Scroll-progress indicator for the sustainability journey.
     Pure read-only scroll listener — never blocks or hijacks scrolling. */
  function initJourney() {
    const journey = document.querySelector<HTMLElement>('[data-journey]');
    const progress = document.querySelector<HTMLElement>('[data-journey-progress]');
    if (!journey || !progress) return;
    if (document.documentElement.dataset.motion === 'off') {
      journey.style.setProperty('--journey-progress', '100%');
      return;
    }

    const update = () => {
      const rect = journey.getBoundingClientRect();
      const viewportMid = window.innerHeight * 0.5;
      const pct = ((viewportMid - rect.top) / rect.height) * 100;
      journey.style.setProperty('--journey-progress', `${Math.min(100, Math.max(0, pct))}%`);
    };

    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  }
  initJourney();
  document.addEventListener('astro:page-load', initJourney);
</script>
