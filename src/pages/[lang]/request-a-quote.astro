---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteWizard from '../../components/QuoteWizard.astro';
import Media from '../../components/Media.astro';
import { localeStaticPaths, href } from '../../i18n/config.ts';
import { t } from '../../i18n/ui.ts';
import { interactive } from '../../content/interactive.ts';

export function getStaticPaths() {
  return localeStaticPaths();
}

const { lang } = Astro.params;
const strings = t(lang);
const copy = interactive[lang].quotePage;
---

<BaseLayout lang={lang} title={copy.meta.title} description={copy.meta.description} hideFloatingQuote>
  <section class="quote-page section">
    <div class="container-x quote-page__grid">
      <div class="quote-page__main">
        <header class="quote-page__head">
          <p class="eyebrow">{copy.eyebrow}</p>
          <h1 class="quote-page__title font-display" set:html={copy.title} />
          <p class="lede">{copy.lede}</p>
        </header>
        <QuoteWizard lang={lang} />
      </div>

      <aside class="quote-page__aside">
        <div class="quote-page__media" data-reveal="mask">
          <Media file="quote-side-workspace" lang={lang} class="quote-page__img" sizes="(min-width: 64rem) 26vw, 85vw" />
        </div>
        <div class="quote-page__help">
          <h2>{strings.pricing.note}</h2>
          <a href={href(lang, 'book')} class="btn btn-ghost">{strings.cta.book}</a>
          <a href={href(lang, 'contact')} class="btn btn-ghost">{strings.cta.contact}</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .quote-page__grid { display: grid; gap: 3rem; align-items: start; }
  @media (min-width: 72rem) { .quote-page__grid { grid-template-columns: 1.6fr 0.6fr; gap: 4rem; } }
  .quote-page__head { margin-bottom: 2.5rem; display: flex; flex-direction: column; gap: 1rem; }
  .quote-page__title { font-size: var(--step-4); }
  .quote-page__title :global(em) { font-style: italic; color: var(--color-clay); }

  .quote-page__aside { display: flex; flex-direction: column; gap: 1.5rem; position: sticky; top: 7rem; }
  .quote-page__media { border-radius: var(--radius-lg); overflow: hidden; }
  .quote-page__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .quote-page__help { display: flex; flex-direction: column; gap: 0.75rem; align-items: flex-start; }
  .quote-page__help h2 { font-family: var(--font-sans); font-size: 0.84rem; font-weight: 500; color: var(--color-ink-soft); line-height: 1.6; letter-spacing: 0; margin-bottom: 0.5rem; }
</style>
