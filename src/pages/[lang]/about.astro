---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Media from '../../components/Media.astro';
import { localeStaticPaths, href } from '../../i18n/config.ts';
import { t } from '../../i18n/ui.ts';
import { pages } from '../../content/pages.ts';

export function getStaticPaths() {
  return localeStaticPaths();
}

const { lang } = Astro.params;
const strings = t(lang);
const copy = pages[lang].about;
---

<BaseLayout lang={lang} title={copy.meta.title} description={copy.meta.description}>
  <PageHero lang={lang} eyebrow={copy.eyebrow} title={copy.title} lede={copy.lede} image="about-hero-team" />

  <section class="section section--top-tight">
    <div class="container-x story">
      <div class="story__text">
        <h2 class="story__title font-display">{copy.storyTitle}</h2>
        {copy.story.map((p) => <p>{p}</p>)}
        <p class="story__note">{copy.note}</p>
      </div>
      <div class="story__media" data-reveal="mask">
        <Media file="about-detail-care" lang={lang} class="story__img" sizes="(min-width: 64rem) 30vw, 85vw" />
      </div>
    </div>
  </section>

  <section class="section surface-forest on-dark">
    <div class="container-x">
      <SectionHeading eyebrow={copy.valuesEyebrow}>
        <Fragment set:html={copy.valuesTitle} />
      </SectionHeading>
      <ul class="values" data-reveal-group>
        {copy.values.map((v, i) => (
          <li data-reveal="fade">
            <span class="values__num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container-x philosophy">
      <div class="philosophy__media" data-reveal="mask">
        <Media file="about-detail-teamwork" lang={lang} class="philosophy__img" sizes="(min-width: 64rem) 32vw, 85vw" />
      </div>
      <div class="philosophy__text">
        <SectionHeading eyebrow={copy.philosophyEyebrow}>
          <Fragment set:html={copy.philosophyTitle} />
        </SectionHeading>
        <p class="philosophy__body">{copy.philosophy}</p>
        <h3 class="philosophy__sub">{copy.teamTitle}</h3>
        <p class="philosophy__body">{copy.teamText}</p>
        <div class="philosophy__actions">
          <a href={href(lang, 'services')} class="btn">{strings.cta.explore}</a>
          <a href={href(lang, 'contact')} class="btn btn-ghost">{strings.cta.contact}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section--top-tight { padding-top: 0; }
  .story { display: grid; gap: 3rem; align-items: start; }
  @media (min-width: 64rem) { .story { grid-template-columns: 1.3fr 0.8fr; gap: 4rem; } }
  .story__title { font-size: var(--step-2); margin-bottom: 1.2rem; }
  .story__text p { color: var(--color-ink-soft); line-height: 1.75; margin-bottom: 1.1rem; max-width: 42rem; }
  .story__note { font-size: 0.85rem; font-style: italic; }
  .story__media { border-radius: var(--radius-lg); overflow: hidden; }
  .story__img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .values { list-style: none; margin: 2.5rem 0 0; padding: 0; display: grid; gap: 2rem; grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .values { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .values { grid-template-columns: repeat(3, 1fr); } }
  .values li { border-top: 1px solid var(--color-line-light); padding-top: 1.1rem; }
  .values__num { font-family: var(--font-display); color: var(--color-sand); font-size: 1.2rem; }
  .values h3 { font-size: 1.05rem; margin: 0.4rem 0; }
  .values p { color: rgb(246 242 233 / 0.78); font-size: 0.92rem; line-height: 1.55; margin: 0; }

  .philosophy { display: grid; gap: 3rem; align-items: center; }
  @media (min-width: 64rem) { .philosophy { grid-template-columns: 0.85fr 1.15fr; gap: 4rem; } }
  .philosophy__media { border-radius: var(--radius-lg); overflow: hidden; }
  .philosophy__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .philosophy__body { color: var(--color-ink-soft); line-height: 1.75; margin-top: 1.25rem; max-width: 38rem; }
  .philosophy__sub { font-size: 1.15rem; margin-top: 2rem; }
  .philosophy__actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; }
</style>
