---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import Media from '../../components/Media.astro';
import { localeStaticPaths, href } from '../../i18n/config.ts';
import { t } from '../../i18n/ui.ts';
import { interactive } from '../../content/interactive.ts';
import { site } from '../../data/site.ts';

export function getStaticPaths() {
  return localeStaticPaths();
}

const { lang } = Astro.params;
const strings = t(lang);
const copy = interactive[lang].contactPage;
---

<BaseLayout lang={lang} title={copy.meta.title} description={copy.meta.description}>
  <section class="contact-hero">
    <div class="container-x contact-hero__head">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1 class="contact-hero__title font-display" set:html={copy.title} />
      <p class="lede">{copy.lede}</p>
    </div>
    <div class="container-x">
      <div class="contact-hero__media" data-reveal="mask">
        <Media file="contact-hero-lounge" lang={lang} class="contact-hero__img" sizes="100vw" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-x contact-grid">
      <div class="contact-grid__form">
        <ContactForm lang={lang} />
      </div>

      <aside class="contact-grid__info">
        <div class="info-block">
          <h2>{copy.detailsTitle}</h2>
          <dl class="info-list">
            <div>
              <dt>{copy.emailLabel}</dt>
              <!-- Deliberately plain text: not a mailto: link, because the address is fictional. -->
              <dd><span class="info-value">{site.contact.email}</span></dd>
            </div>
            <div>
              <dt>{copy.phoneLabel}</dt>
              <dd><span class="info-value">{site.contact.phone}</span></dd>
            </div>
          </dl>
          <p class="info-note">{copy.placeholderNote}</p>
          <p class="info-note">{copy.hoursNote}</p>
        </div>

        <div class="info-block">
          <h2>{copy.citiesTitle}</h2>
          <ul class="city-list">
            {site.cities.map((city) => <li>{city[lang]}</li>)}
          </ul>
        </div>

        <div class="info-block">
          <h2>{copy.shortcutsTitle}</h2>
          <div class="shortcut">
            <a href={href(lang, 'quote')} class="btn">
              {strings.cta.quote}
              <span class="btn-arrow" aria-hidden="true">→</span>
            </a>
            <p>{copy.quoteText}</p>
          </div>
          <div class="shortcut">
            <a href={href(lang, 'book')} class="btn btn-ghost">{strings.cta.book}</a>
            <p>{copy.bookText}</p>
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero { padding-top: clamp(2.5rem, 2rem + 2vw, 4rem); }
  .contact-hero__head { max-width: 44rem; display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2.5rem; }
  .contact-hero__title { font-size: var(--step-4); }
  .contact-hero__title :global(em) { font-style: italic; color: var(--color-clay); }
  .contact-hero__media { border-radius: var(--radius-xl); overflow: hidden; max-height: 26rem; }
  .contact-hero__img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .contact-grid { display: grid; gap: 3rem; align-items: start; }
  @media (min-width: 72rem) { .contact-grid { grid-template-columns: 1.4fr 0.8fr; gap: 4rem; } }

  .contact-grid__info { display: flex; flex-direction: column; gap: 2.5rem; }
  .info-block h2 { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-clay); margin-bottom: 1rem; }
  .info-list { display: grid; gap: 0.1rem; margin: 0; }
  .info-list > div { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem; padding: 0.7rem 0; border-bottom: 1px solid var(--color-line); }
  .info-list dt { color: var(--color-ink-soft); font-size: 0.9rem; }
  .info-list dd { margin: 0; }
  .info-value { font-weight: 700; user-select: all; }
  .info-note { font-size: 0.8rem; color: var(--color-ink-soft); margin-top: 0.85rem; line-height: 1.6; }

  .city-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.5rem; font-weight: 650; font-size: 0.93rem; }

  .shortcut { display: flex; flex-direction: column; align-items: flex-start; gap: 0.6rem; margin-bottom: 1.5rem; }
  .shortcut p { font-size: 0.86rem; color: var(--color-ink-soft); margin: 0; }
</style>
